          "name": "Get own state vectors",
          "request": {
            "name": "Get own state vectors",
            "description": {
              "content": "Retrieve state vectors for your own sensors. This endpoint requires authentication and is not rate limited for your own receivers. Returns state vectors from sensors you operate.",
              "type": "text/plain"
            },
