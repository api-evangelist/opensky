      "id": "4fdcda78-b0fb-425c-a1a1-cb452a021efd",
      "name": "State Vectors",
      "description": {
        "content": "Endpoints for retrieving real-time and historical aircraft state vectors (position, velocity, altitude, etc.).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "91670eb2-19a8-4462-81bf-2ae4ab7ce2d9",
          "name": "Get all state vectors",
          "request": {
            "name": "Get all state vectors",
            "description": {
              "content": "Retrieve any state vector of the OpenSky Network. Returns state vectors for all aircraft currently tracked. Rate limits apply (see rate limiting documentation). Anonymous users receive 10-second resolution; authenticated users receive 5-second resolution.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "states",
                "all"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<integer>",
                  "description": "The time in seconds since epoch (Unix timestamp) to retrieve state vectors for. Current time is used if omitted."
                },
                {
                  "disabled": false,
                  "key": "icao24",
                  "value": "<string>",
                  "description": "One or more ICAO24 transponder addresses represented by a hex string (e.g. abc9f3). To filter multiple aircraft, repeat this parameter."
                },
                {
                  "disabled": false,
                  "key": "icao24",
                  "value": "<string>",
                  "description": "One or more ICAO24 transponder addresses represented by a hex string (e.g. abc9f3). To filter multiple aircraft, repeat this parameter."
                },
                {
                  "disabled": false,
                  "key": "lamin",
                  "value": "<float>",
                  "description": "Lower bound for the latitude in decimal degrees of the bounding box."
                },
                {
                  "disabled": false,
                  "key": "lomin",
                  "value": "<float>",
                  "description": "Lower bound for the longitude in decimal degrees of the bounding box."
                },
                {
                  "disabled": false,
                  "key": "lamax",
                  "value": "<float>",
                  "description": "Upper bound for the latitude in decimal degrees of the bounding box."
                },
                {
                  "disabled": false,
                  "key": "lomax",
                  "value": "<float>",
                  "description": "Upper bound for the longitude in decimal degrees of the bounding box."
                },
                {
                  "disabled": false,
                  "key": "extended",
                  "value": "<integer>",
                  "description": "Set to 1 to request the extended state vector format which includes aircraft category (index 17)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
