                  "disabled": false,
                  "key": "icao24",
                  "value": "<string>",
                  "description": "One or more ICAO24 transponder addresses represented by a hex string. To filter multiple aircraft, repeat this parameter."
                },
                {
                  "disabled": false,
                  "key": "serials",
