      "name": "Tracks",
      "description": {
        "content": "Endpoints for retrieving aircraft trajectory tracks with detailed waypoint data.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "300bf52f-cb03-46c8-81fa-70d41c7380a4",
          "name": "Get track by aircraft",
          "request": {
            "name": "Get track by aircraft",
            "description": {
              "content": "Retrieve the trajectory for a certain aircraft at a given time. The track is a list of waypoints containing position, altitude, and velocity information. Set time to 0 to get the live track.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tracks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "icao24",
                  "value": "<string>",
                  "description": "(Required) Unique ICAO 24-bit address of the transponder in lower-case hex string representation (e.g. 3c6444)."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<integer>",
                  "description": "Unix timestamp within the time window of the flight to retrieve. Set to 0 for the live track of the aircraft."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
